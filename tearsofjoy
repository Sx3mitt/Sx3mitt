local sendInterval = 1 / clamp(CONFIG.SEND_RATE, 5, 60)
local sincePeers = 0

local okPre, preSignal = pcall(function()
	return RunService.PreSimulation
end)
local stepSignal = okPre and preSignal or nil
local stepIsPre = stepSignal ~= nil
stepSignal = stepSignal or RunService.Stepped

hook(stepSignal, function(a, b)
	if not alive then
		return
	end

	local dt = (stepIsPre and a or b) or 1 / 60
	sinceSend += dt
	if sinceSend >= sendInterval then
		sinceSend = 0
		senderStep()
	end
	poseStep(dt)
end)

hook(RunService.Heartbeat, function(dt)
	if not alive then
		return
	end

	travelStep()
	sincePeers += dt
	if sincePeers >= 0.1 then
		sincePeers = 0
		peerStep()
	end
end)

hook(RunService.RenderStepped, function(dt)
	if not alive then
		return
	end
	visualStep(dt)
	hudStep()
end)

local function closeSocket()
	if not socket then
		return
	end
	pcall(function()
		if socket.Close then
			socket:Close()
		elseif socket.close then
			socket:close()
		end
	end)
	socket = nil
end

local function emptyBin()
	for index = #bin, 1, -1 do
		local item = bin[index]
		bin[index] = nil
		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			else
				item:Destroy()
			end
		end)
	end
end

function Bridge.stop()
	if not alive then
		return
	end
	alive = false

	for character, holder in pairs(holders) do
		pcall(detach, holder)
		holders[character] = nil
	end
	for id, record in pairs(portals) do
		portals[id] = nil
		pcall(function()
			record.model:Destroy()
		end)
	end
	table.clear(pair.ids)
	table.clear(peers)

	closeSocket()
	connected = false
	emptyBin()

	UserInputService.MouseIconEnabled = true
	statusLabel, shootButton, clearButton, cursorFrame, hud, tool = nil, nil, nil, nil, nil, nil
end

function Bridge.clear()
	clearPortals(true)
end

