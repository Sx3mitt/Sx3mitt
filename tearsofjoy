local holders = setmetatable({}, { __mode = "k" })

local function detach(holder)
	if not holder then
		return
	end
	if holder.rig and holder.rig.shoulder.Parent then
		holder.rig.shoulder.C0 = holder.rig.rest
	end
	if holder.motor then
		holder.motor:Destroy()
	end
	if holder.gun then
		holder.gun:Destroy()
	end
	holder.motor, holder.gun, holder.count, holder.barrel = nil, nil, nil, nil
	holder.posed = false
end

local function attach(holder)
	local rig = holder.rig
	if not rig or holder.motor then
		return
	end

	local gun, count = buildGun()
	local grip = gripFor(rig)
	gun.Parent = holder.character
	gun:PivotTo(rig.hand.CFrame * grip)

	local motor = Instance.new("Motor6D")
	motor.Name = "PortalGunGrip"
	motor.Part0 = rig.hand
	motor.Part1 = gun.PrimaryPart
	motor.C0 = grip
	motor.Parent = rig.hand

	holder.gun, holder.motor, holder.count = gun, motor, count
	holder.barrel = gun.PrimaryPart
	if holder.rounds then
		count.Text = tostring(holder.rounds)
	end
end

local function holderFor(character)
	local holder = holders[character]
	if holder then
		if holder.rig.torso.Parent and holder.rig.shoulder.Parent then
			return holder
		end
		holders[character] = nil
		return nil
	end

	local rig = rigOf(character)
	if not rig then
		return nil
	end
	rig.rest = rig.shoulder.C0

	holder = {
		character = character,
		rig = rig,
		pitch = 0,
		yaw = 0,
		blend = 0,
		wantPitch = 0,
		wantYaw = 0,
		wantBlend = 0,
		posed = false,
		equipped = false,
		point = nil,
		pointAt = 0,
	}
	holders[character] = holder
	return holder
end

local function poseStep(dt)
	for character, holder in pairs(holders) do
		local rig = holder.rig
		if not (character.Parent and rig.torso.Parent and rig.shoulder.Parent and rig.arm.Parent) then
			holders[character] = nil
			continue
		end

		if holder.wantBlend <= 0 and not holder.posed then
			continue
		end

		holder.pitch = smooth(holder.pitch, holder.wantPitch, dt)
		holder.yaw = smoothAngle(holder.yaw, holder.wantYaw, dt)
		holder.blend = smooth(holder.blend, holder.wantBlend, dt)

		if holder.blend <= 0.002 then
			holder.blend = 0
			holder.posed = false
			rig.shoulder.C0 = rig.rest
		else
			holder.posed = true
			local torsoCF = rig.torso.CFrame
			local armCF = armPose(rig, torsoCF, holder.pitch, holder.yaw)
			rig.shoulder.C0 = rig.rest:Lerp(aimC0(rig, torsoCF, armCF), holder.blend)
		end
	end
end

