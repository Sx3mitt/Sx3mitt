local function buildHud()
	local old = LP.PlayerGui:FindFirstChild("PortalBridgeHud")
	if old then
		old:Destroy()
	end

	hud = keep(Instance.new("ScreenGui"))
	hud.Name = "PortalBridgeHud"
	hud.ResetOnSpawn = false
	hud.DisplayOrder = 5
	hud.IgnoreGuiInset = false
	pcall(function()
		hud.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	end)
	hud.Parent = LP.PlayerGui

	statusLabel = buildStatusLabel(hud)
	cursorFrame = buildCursor(hud)

	if not TOUCH_CAPABLE then
		return
	end

	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1024, 768)
	local side = clamp(min(viewport.X, viewport.Y) * 0.18, 84, 150)

	shootButton = buildCircle(hud, "Shoot", "SHOOT", 0, side, fire)
	clearButton = buildCircle(hud, "Clear", "CLEAR", 1, side, function()
		clearPortals(true)
	end)
end

local function hudStep()
	if not cursorFrame then
		return
	end

	local onTouch = equipped and usingTouch
	cursorFrame.Visible = equipped
	if shootButton then
		shootButton.Visible = onTouch
	end
	if clearButton then
		clearButton.Visible = onTouch
	end

	if equipped ~= iconHidden then
		iconHidden = equipped
		UserInputService.MouseIconEnabled = not equipped
	end
	if not equipped then
		return
	end

	if usingTouch or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		local camera = workspace.CurrentCamera
		if camera then
			local middle = camera.ViewportSize * 0.5 - GuiService:GetGuiInset()
			cursorFrame.Position = UDim2.fromOffset(middle.X, middle.Y)
		end
	else
		local at = UserInputService:GetMouseLocation()
		cursorFrame.Position = UDim2.fromOffset(at.X, at.Y)
	end
end

local function isTouch(inputType)
	return inputType == Enum.UserInputType.Touch
		or inputType == Enum.UserInputType.Gyro
		or inputType == Enum.UserInputType.Accelerometer
end

local function isPointer(inputType)
	return inputType == Enum.UserInputType.MouseMovement
		or inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.MouseButton2
		or inputType == Enum.UserInputType.MouseWheel
		or inputType == Enum.UserInputType.Keyboard
end

if TOUCH_CAPABLE then
	if isTouch(UserInputService:GetLastInputType()) then
		usingTouch = true
	end
	hook(UserInputService.LastInputTypeChanged, function(inputType)
		if isTouch(inputType) then
			usingTouch = true
		elseif isPointer(inputType) then
			usingTouch = false
		end
	end)
end

