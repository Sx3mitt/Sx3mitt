	equipped = false
	published = nil
	rounds = ammo

	task.defer(function()
		if alive then
			buildTool()
			setAmmo(rounds)
			send("e0")
		end
	end)

	character.AncestryChanged:Once(function()
		local holder = holders[character]
		if holder then
			detach(holder)
			holders[character] = nil
		end
