--=========================================================================
-- one character's gun and pose state
--=========================================================================

-- character -> holder. Weak keyed, so a character that goes away takes its entry
-- with it whether or not the loop below notices first.
local holders = setmetatable({}, { __mode = "k" })

local function detach(holder)
	if not holder then
		return
	end
	if holder.rig and holder.rig.shoulder.Parent then
		holder.rig.shoulder.C0 = holder.rig.rest -- hand the joint back to the Animator
	end
	if holder.motor then
		holder.motor:Destroy()
	end
	if holder.gun then
		holder.gun:Destroy()
	end
	holder.motor, holder.gun, holder.count = nil, nil, nil
	holder.posed = false
end

-- Studio made this Motor6D on the server so the grip replicated. Here nothing
-- replicates, so each machine makes its own for each character - which is the
-- same result by a different road, and the reason both guns are built locally.
local function attach(holder)
	local rig = holder.rig
	if not rig or holder.motor then
		return
	end

	local gun, count = buildGun()
	local grip = gripFor(rig)
	gun.Parent = holder.character -- a sibling of the limbs, not under the Tool
	gun:PivotTo(rig.hand.CFrame * grip) -- in place before it is jointed, or it
	                                    -- flashes at the origin for a frame

	local motor = Instance.new("Motor6D")
	motor.Name = "PortalGunGrip"
	motor.Part0 = rig.hand
	motor.Part1 = gun.PrimaryPart
	motor.C0 = grip
	motor.Parent = rig.hand

	holder.gun, holder.motor, holder.count = gun, motor, count
	holder.barrel = gun.PrimaryPart
	if holder.ammo then
		count.Text = tostring(holder.ammo)
	end
end

-- Built the first time a character actually needs one rather than off
-- CharacterAdded: a rig assembled by hand (EnforceR6 and the like) can be a
-- frame or two behind the character appearing, and a rig that was not ready then
-- used to be missed for the rest of that life.
local function holderFor(character)
	local holder = holders[character]
	if holder then
		if holder.rig.torso.Parent and holder.rig.shoulder.Parent then
			return holder
		end
		holders[character] = nil -- the rig went away under us
		return nil
	end

	local rig = rigOf(character)
	if not rig then
		return nil -- neither rig, or not built yet; the next frame tries again
	end
	rig.rest = rig.shoulder.C0 -- read before anything below writes it

	holder = {
		character = character,
		rig = rig,
		pitch = 0,
		yaw = 0,
		blend = 0,
		posed = false,
		equipped = false,
		ammo = nil,
		point = nil, -- world point being aimed at (local player only)
		pointAt = 0,
		wantPitch = 0,
		wantYaw = 0,
		wantBlend = 0,
	}
	holders[character] = holder
	return holder
end

--=========================================================================
-- the pose loop (was PortalGunAimClient, now for both characters)
--=========================================================================

-- PreSimulation is after the Animator has evaluated this frame and before physics
-- moves anything, so cancelling Transform out of C0 is exact. On PostSimulation
-- the next frame's animation overwrites the write.
local function poseStep(dt)
	for character, holder in pairs(holders) do
		if not character.Parent then
			holders[character] = nil
			continue
		end
		local rig = holder.rig
		if not (rig.torso.Parent and rig.shoulder.Parent and rig.arm.Parent) then
			holders[character] = nil
			continue
		end

		local wantPitch, wantYaw, wantBlend = holder.wantPitch, holder.wantYaw, holder.wantBlend
		if wantBlend <= 0 and not holder.posed then
			continue -- relaxed, and already handed back to the Animator
		end

		holder.pitch = smooth(holder.pitch, wantPitch, dt)
		holder.yaw = smoothAngle(holder.yaw, wantYaw, dt)
		holder.blend = smooth(holder.blend, wantBlend, dt)

		if holder.blend <= RELAXED then
			holder.blend = 0
			holder.posed = false
			rig.shoulder.C0 = rig.rest
		else
			holder.posed = true
			local torsoCF = rig.torso.CFrame
			local armCF = armPose(rig, torsoCF, holder.pitch, holder.yaw)
			rig.shoulder.C0 = rig.rest:Lerp(aimC0(rig, torsoCF, armCF), holder.blend)
		end
	end
end

