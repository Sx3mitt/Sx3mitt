local function smooth(current, target, dt)
	return current + (target - current) * (1 - exp(-dt * 16))
end

local function wrapAngle(angle)
	return (angle + pi) % (pi * 2) - pi
end

local function smoothAngle(current, target, dt)
	return wrapAngle(current + wrapAngle(target - current) * (1 - exp(-dt * 16)))
end

local function clampYaw(yaw, current)
	local across, behind = rad(55), rad(130)
	if yaw <= across or yaw >= behind then
		return yaw
	end

	local middle = (across + behind) * 0.5
	if not current then
		return yaw < middle and across or behind
	end

	local margin = rad(12)
	if abs(wrapAngle(current - behind)) < abs(wrapAngle(current - across)) then
		return yaw > middle - margin and behind or across
	end
	return yaw < middle + margin and across or behind
end

local function armRoll(yaw)
	local from = rad(30)
	local t = clamp((abs(yaw) - from) / (pi - from), 0, 1)
	return pi * t * t * (3 - 2 * t) * (yaw < 0 and -1 or 1)
end

local function armRotation(torsoCF, pitch, yaw)
	local direction = torsoCF:VectorToWorldSpace(CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).LookVector)
	local up = abs(direction.Y) > 0.999 and Vector3.zAxis or Vector3.yAxis
	return (
		CFrame.lookAt(Vector3.zero, direction, up)
		* CFrame.Angles(pi * 0.5, 0, 0)
		* CFrame.Angles(0, armRoll(yaw), 0)
	).Rotation
end

local function rigOf(character)
