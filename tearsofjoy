local function decorate(part)
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	part.CanQuery = false -- the gun must never be raycast, least of all by its own shots
	part.CanTouch = false
	return part
end

-- Studio had these two as MeshParts in ServerStorage. At runtime MeshPart.MeshId
-- is not assignable, so the real path is AssetService:CreateMeshPartAsync, which
-- also keeps SurfaceAppearance working (the gold PBR set). Where that is not
-- available we fall back to a Part + SpecialMesh, which renders the mesh but
-- takes a TextureID instead of the PBR maps - the gun looks flatter, and works.
local function meshPart(meshId, size, textureId, pbr)
	local ok, part = pcall(function()
		return AssetService:CreateMeshPartAsync(meshId, {
			CollisionFidelity = Enum.CollisionFidelity.Box,
			RenderFidelity = Enum.RenderFidelity.Automatic,
		})
	end)
	if ok and part then
		part.Size = size
		if textureId then
			pcall(function()
				part.TextureID = textureId
			end)
		end
		if pbr then
			pcall(function()
				local look = Instance.new("SurfaceAppearance")
				look.ColorMap = pbr.ColorMap
				look.MetalnessMap = pbr.MetalnessMap
				look.NormalMap = pbr.NormalMap
				look.RoughnessMap = pbr.RoughnessMap
				look.AlphaMode = Enum.AlphaMode.Overlay
				look.Parent = part
			end)
		end
		return decorate(part)
	end

	local fallback = Instance.new("Part")
	fallback.Size = size
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = meshId
	mesh.Scale = size -- no native mesh bounds to read here; tune if it looks off
	if textureId then
		mesh.TextureId = textureId
	end
	mesh.Parent = fallback
	return decorate(fallback)
end

