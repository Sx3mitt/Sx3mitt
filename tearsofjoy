	end
	return fallback
end

local function handshake()
	return HttpService:JSONEncode({
		t = "hello",
		v = 1,
		room = CONFIG.ROOM,
		token = CONFIG.TOKEN,
		uid = LP.UserId,
		name = LP.Name,
		job = game.JobId,
		place = game.PlaceId,
		ps = serverFact("PrivateServerId", ""),
		owner = serverFact("PrivateServerOwnerId", 0),
		ts = os.time(),
		nonce = HttpService:GenerateGUID(false),
	})
end

local function dropPeer(userId)
	local peer = peers[userId]
	if not peer then
		return
	end
	peers[userId] = nil

	for index = #pair.ids, 1, -1 do
		local record = portals[pair.ids[index]]
		if record and record.owner == userId then
			closePortal(record.id)
		end
	end

	if peer.character then
		local holder = holders[peer.character]
		if holder then
			detach(holder)
			holder.wantBlend = 0
			holder.equipped = false
		end
	end
end

local function peerHolder(userId)
	local peer = peers[userId]
	if not peer then
		peer = {}
		peers[userId] = peer
	end

	local player = peer.player
	if not (player and player.Parent) then
		player = Players:GetPlayerByUserId(userId)
		peer.player = player
	end
	if not player then
		return nil, peer
	end

	local character = player.Character
	if not (character and character.Parent) then
		return nil, peer
	end
	peer.character = character
	return holderFor(character), peer
end

local function peerStep()
	for userId, peer in pairs(peers) do
		if peer.equipped then
			local holder = peerHolder(userId)
			if holder then
				holder.equipped = true
				if not holder.motor then
					holder.rounds = peer.rounds
					attach(holder)
				end
			end
		end
	end
end

local rounds = ammo
local equipped = false
local lastShot = 0
local shotCounter = 0
local published = nil
local sinceSend = 0
local shootButton, clearButton

local function onControl(text)
	local ok, message = pcall(HttpService.JSONDecode, HttpService, text)
	if not (ok and type(message) == "table") then
		return
	end

	if message.t == "welcome" then
		connected = true
		setStatus("bridged  ." .. CONFIG.ROOM, Color3.fromRGB(120, 235, 140))
		send("e" .. (equipped and 1 or 0))
		send("m" .. rounds)
	elseif message.t == "leave" and message.uid then
		dropPeer(message.uid)
	elseif message.t == "error" then
		connected = false
		setStatus("relay refused: " .. tostring(message.m), Color3.fromRGB(240, 120, 120))
		warn("[PortalBridge] relay refused the handshake: " .. tostring(message.m))
	end
end

local function onAim(userId)
	local holder = peerHolder(userId)
	if holder then
		holder.wantPitch = fields[2] / 10000
		holder.wantYaw = fields[3] / 10000
		holder.wantBlend = fields[4] / 255
		holder.pointAt = os.clock()
	end
end

local function onEquipped(userId)
	local holder, peer = peerHolder(userId)
	local on = fields[2] == 1
	peer.equipped = on
	if not holder then
		return
	end
	holder.equipped = on
	if on then
		attach(holder)
	else
		detach(holder)
		holder.wantBlend = 0
	end
end

local function onAmmo(userId)
	local holder, peer = peerHolder(userId)
	peer.rounds = fields[2]
	if holder then
		holder.rounds = fields[2]
		if holder.count then
			holder.count.Text = tostring(fields[2])
		end
	end
end

local function onShot(userId, count)
	if count < 9 then
		return
	end
	local n = fields[2]
	local muzzle = Vector3.new(fields[3] / 100, fields[4] / 100, fields[5] / 100)
	local landing = Vector3.new(fields[6] / 100, fields[7] / 100, fields[8] / 100)
	local hit = fields[9] == 1
	local normal = hit
			and count >= 12
			and Vector3.new(fields[10] / 1000, fields[11] / 1000, fields[12] / 1000)
		or Vector3.yAxis

	shootFluid(muzzle, landing, function()
		arrive(userId, n, hit, landing + normal * 0.1, normal)
	end)
end

local function onTravel(count)
	if count < 4 then
		return
	end
	local owner = fields[2]
	local from = portals[owner .. ":" .. fields[3]]
	local to = portals[owner .. ":" .. fields[4]]
	if from then
		playAt(from.plate.Position, "Enter")
	end
	if to then
		playAt(to.plate.Position, "Enter")
	end
end

onFrame = function(text)
	if type(text) ~= "string" or #text < 2 then
		return
	end

	local kind = string.byte(text, 1)
	if kind == 123 then
		return onControl(text)
	end

	local count = split(text, 2)
	local userId = fields[1]
	if not userId or userId == LP.UserId then
		return
	end

	if kind == 97 then
		if count >= 4 then
			onAim(userId)
		end
	elseif kind == 101 then
		onEquipped(userId)
	elseif kind == 109 then
		onAmmo(userId)
	elseif kind == 115 then
		onShot(userId, count)
	elseif kind == 99 then
		closePortal(userId .. ":" .. fields[2])
	elseif kind == 120 then
		clearPortals(false)
	elseif kind == 116 then
		onTravel(count)
	end
end

local function pump(sock)
	local ok, signal = pcall(function()
		return sock.OnMessage or sock.onMessage or sock.OnMessageReceived
	end)
	if ok and signal then
		keep(signal:Connect(function(text)
			pcall(onFrame, text)
		end))
	end

	local shut
	ok, shut = pcall(function()
		return sock.OnClose or sock.onClose
	end)
	if ok and shut then
		keep(shut:Connect(function()
			connected = false
			socket = nil
			setStatus("relay dropped - retrying", Color3.fromRGB(240, 190, 110))
		end))
	end
end

task.spawn(function()
	while alive do
		if not socket then
			setStatus("dialling " .. CONFIG.HOST .. " ...", Color3.fromRGB(240, 190, 110))
			local sock = socketConnect(URL)
			if sock then
				socket = sock
				pump(sock)
				socketSend(sock, handshake())
			else
				setStatus("no WebSocket in this executor", Color3.fromRGB(240, 120, 120))
			end
		end
		task.wait(CONFIG.RECONNECT)
	end
end)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local shotParams = RaycastParams.new()
shotParams.FilterType = Enum.RaycastFilterType.Exclude
shotParams.IgnoreWater = true

local function setAmmo(value)
	rounds = clamp(value, 0, ammo)

	local holder = LP.Character and holders[LP.Character]
	if holder then
		holder.rounds = rounds
		if holder.count then
			holder.count.Text = tostring(rounds)
		end
	end

	send("m" .. rounds)

	if shootButton then
		shootButton.BackgroundTransparency = rounds <= 0 and 0.6 or 0.15
		shootButton.TextTransparency = rounds <= 0 and 0.55 or 0
	end
end

local function cursorPoint(camera)
	if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter or not UserInputService.MouseEnabled then
		return camera.ViewportSize * 0.5
	end
	return UserInputService:GetMouseLocation()
end

local function senderStep()
	local character = LP.Character
	if not character then
		return
	end
	local holder = holderFor(character)
	if not holder then
		return
	end

	local camera = workspace.CurrentCamera
	if equipped and camera then
		local cursor = cursorPoint(camera)
		local ray = camera:ViewportPointToRay(cursor.X, cursor.Y)
		rayParams.FilterDescendantsInstances = { character, folder }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)
		holder.point = hit and hit.Position or ray.Origin + ray.Direction * 2000
		holder.pointAt = os.clock()
	end

	local wantPitch, wantYaw, wantBlend = 0, 0, 0
	if equipped and holder.point and os.clock() - holder.pointAt <= 0.4 then
		local torsoCF = holder.rig.torso.CFrame
		local offset = holder.point - armAnchor(holder.rig, torsoCF)
		if offset.Magnitude > 0.5 then
			local direction = torsoCF:VectorToObjectSpace(offset.Unit)
			local limit = rad(75)
			wantYaw = clampYaw(atan2(-direction.X, -direction.Z), holder.yaw)
			wantPitch = clamp(asin(clamp(direction.Y, -1, 1)), -limit, limit)
			wantBlend = 1
		end
	end
	holder.wantPitch, holder.wantYaw, holder.wantBlend = wantPitch, wantYaw, wantBlend

	local target = Vector3.new(wantPitch, wantYaw, wantBlend)
	if not published or (published - target).Magnitude > 0.004 then
		published = target
		send("a" .. q(wantPitch, 10000) .. "," .. q(wantYaw, 10000) .. "," .. q(wantBlend, 255))
	end
end

local function resolveShot(character, muzzle, direction)
	shotParams.FilterDescendantsInstances = { character, folder }
	local hit = workspace:Raycast(muzzle, direction * 300, shotParams)
	if hit then
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			return nil
		end
	end
	return hit
end

local function fire()
	local character = LP.Character
	local holder = character and holders[character]
	if not (equipped and holder) then
		return
	end

	local now = os.clock()
	if lastShot + 0.35 > now or rounds <= 0 then
		return
	end
	if not (holder.point and now - holder.pointAt <= 0.4) then
		return
	end

	local barrel = holder.barrel
	if not (barrel and barrel.Parent) then
		return
	end

	local muzzle = (barrel.CFrame * CFrame.new(barrel.Size.X * 0.5 + 0.2, 0, 0)).Position
	local offset = holder.point - muzzle
	if offset.Magnitude < 1 then
		return
	end

	lastShot = now
	setAmmo(rounds - 1)

	local hit = resolveShot(character, muzzle, offset.Unit)
	local landing = hit and hit.Position or muzzle + offset.Unit * 300
	local normal = hit and hit.Normal or Vector3.yAxis

	shotCounter += 1
	local n = shotCounter

	local frame = "s" .. n .. "," .. packV3(muzzle) .. "," .. packV3(landing) .. "," .. (hit and 1 or 0)
	if hit then
		frame = frame .. "," .. q(normal.X, 1000) .. "," .. q(normal.Y, 1000) .. "," .. q(normal.Z, 1000)
	end
	send(frame)

	shootFluid(muzzle, landing, function()
		arrive(LP.UserId, n, hit ~= nil, landing + normal * 0.1, normal)
	end)
end

local tool = nil

local function buildTool()
	if tool then
		tool:Destroy()
	end
	local backpack = LP:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	tool = keep(Instance.new("Tool"))
	tool.Name = "PortalGun"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Golden Portal Gun"
	tool:SetAttribute("PortalGun", true)

	hook(tool.Equipped, function()
		equipped = true
		published = nil
		local holder = LP.Character and holderFor(LP.Character)
		if holder then
			holder.equipped = true
			attach(holder)
		end
		send("e1")
		setAmmo(rounds)
	end)

	hook(tool.Unequipped, function()
		equipped = false
		published = nil
		local holder = LP.Character and holders[LP.Character]
		if holder then
			holder.equipped = false
			holder.wantBlend = 0
			detach(holder)
		end
		send("e0")
	end)

	hook(tool.Activated, fire)
	tool.Parent = backpack
end

