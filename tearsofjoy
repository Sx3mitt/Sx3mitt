local function slab(origin, delta, half, tmin, tmax)
	if abs(delta) < 1e-6 then
		if abs(origin) > half then
			return nil, nil
		end
		return tmin, tmax
	end

	local t1, t2 = (-half - origin) / delta, (half - origin) / delta
	if t1 > t2 then
		t1, t2 = t2, t1
	end
	if t1 > tmin then
		tmin = t1
	end
	if t2 < tmax then
		tmax = t2
	end
	if tmin > tmax then
		return nil, nil
	end
	return tmin, tmax
end

local function insidePortal(record, top, bottom)
	local cf = record.plate.CFrame
	local a, b = cf:PointToObjectSpace(top), cf:PointToObjectSpace(bottom)

	local tmin, tmax = slab(a.X, b.X - a.X, 6, 0, 1)
	if not tmin then
		return false
	end
	tmin, tmax = slab(a.Y, b.Y - a.Y, 6, tmin, tmax)
	if not tmin then
		return false
	end
	return (slab(a.Z, b.Z - a.Z, 2.5, tmin, tmax)) ~= nil
end

local function doTravel(record, exit, root)
	local out = exit.plate.CFrame.LookVector
	local flat = Vector3.new(out.X, 0, out.Z)
	local facing = flat.Magnitude > 0.1 and flat.Unit or root.CFrame.LookVector
	local landing = exit.plate.Position + out * 3.5

	root.CFrame = CFrame.lookAt(landing, landing + facing)
	root.AssemblyLinearVelocity = out * math.max(root.AssemblyLinearVelocity.Magnitude, 22)
	playAt(record.plate.Position, "Enter")
	playAt(exit.plate.Position, "Enter")
end

local function travelStep()
	local character = LP.Character
	if not (character and character.Parent) then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not (humanoid and humanoid.Health > 0) then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	if not root then
		return
	end

	local now = os.clock()
	if (travelling[character] or 0) > now then
		return
	end

	local rootHalf = root.Size.Y * 0.5
	local top = root.Position + Vector3.yAxis * (rootHalf + 2)
	local bottom = root.Position - Vector3.yAxis * (rootHalf + (humanoid.HipHeight or 2) + 1)

	for _, id in ipairs(pair.ids) do
		local record = portals[id]
		if record and record.open and not record.closing and insidePortal(record, top, bottom) then
			local exit = partner(record)
			if exit then
				travelling[character] = now + cooldown
				doTravel(record, exit, root)
				send("t" .. record.owner .. "," .. record.n .. "," .. exit.n)
				return
			end
		end
	end
end

local function visualStep(dt)
	local clock = os.clock()
	for _, record in pairs(portals) do
		if not record.closing then
			record.image.Rotation = (record.image.Rotation + 22 * dt) % 360
			if record.open then
				record.light.Brightness = 2.4 * (1 + 0.18 * sin(clock * 2.5))
			end
		end
	end
end

local fields = table.create(16)

local function q(n, scale)
	return tostring(floor(n * scale + 0.5))
end

local function packV3(v)
	return q(v.X, 100) .. "," .. q(v.Y, 100) .. "," .. q(v.Z, 100)
end

local function split(text, from)
	local n = 0
	local length = #text
	table.clear(fields)

	while from <= length do
		local comma = string.find(text, ",", from, true)
		n += 1
		if comma then
			fields[n] = tonumber(string.sub(text, from, comma - 1))
			from = comma + 1
		else
			fields[n] = tonumber(string.sub(text, from))
			break
		end
	end
	return n
end

local SOCKET_FACTORIES = {
	function()
		return WebSocket and WebSocket.connect
	end,
	function()
		return websocket and websocket.connect
	end,
	function()
		return syn and syn.websocket and syn.websocket.connect
	end,
	function()
		return Websocket and Websocket.connect
	end,
}

local function socketConnect(url)
	for _, factory in ipairs(SOCKET_FACTORIES) do
		local ok, connect = pcall(factory)
		if ok and type(connect) == "function" then
			local opened, socket = pcall(connect, url)
			if opened and socket then
				return socket
			end
		end
	end
	return nil
end

local function socketSend(socket, text)
	if socket.Send then
		if pcall(socket.Send, socket, text) then
			return true
		end
		return pcall(socket.Send, text)
	end
	if socket.send then
		return pcall(socket.send, socket, text)
	end
	return false
end

