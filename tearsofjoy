local portals = {} -- id -> record
-- One pair for the whole session, not one per player. Either player's portal
-- pairs with the other's, so A can drop one end and B the other - which is what
-- makes the bridge worth having and is the one place this deliberately parts
-- company with the Studio build.
local pair = { ids = {} }
local travelling = setmetatable({}, { __mode = "k" }) -- character -> clock

-- One shot each, on a host that outlives the portal, so a portal collapsing does
-- not cut its own closing sound off.
local function playAt(position, kind)
	local host = Instance.new("Part")
	host.Name = "PortalSound"
	host.Size = Vector3.one
	host.CFrame = CFrame.new(position)
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.CanTouch = false
	host.Transparency = 1
	host.Parent = folder

	local sound = Instance.new("Sound")
	sound.SoundId = SOUNDS[kind]
	sound.RollOffMaxDistance = 150
	sound.Parent = host
	sound:Play()
	sound.Ended:Once(function()
		host:Destroy()
	end)
	Debris:AddItem(host, 8) -- a sound ID that never loads never raises Ended
end

local function forgetId(id)
	local ids = pair.ids
	for index = 1, #ids do
		if ids[index] == id then
			table.remove(ids, index)
			return
		end
	end
end

local function closePortal(id)
	local record = portals[id]
	if not record or record.closing then
		return
	end
	record.closing = true
	portals[id] = nil
	forgetId(id) -- or a dead id would count towards the pair and trim a live one
	playAt(record.plate.Position, "Close")
	TweenService:Create(
		record.image,
		TweenInfo.new(CLOSE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Size = UDim2.fromScale(0, 0), ImageTransparency = 1 }
	):Play()
	TweenService:Create(record.light, TweenInfo.new(CLOSE_TIME), { Brightness = 0, Range = 0 }):Play()
	task.delay(CLOSE_TIME, function()
		record.model:Destroy()
	end)
end

local function openPortal(owner, n, position, normal)
	local id = owner .. ":" .. n
	if portals[id] then
		return
	end
	-- lookAt needs an up vector that is not the normal itself, which floors and
	-- ceilings would otherwise hand it
	local up = abs(normal.Y) > 0.99 and Vector3.zAxis or Vector3.yAxis

	local model = Instance.new("Model")
	model.Name = "Portal"

	local plate = Instance.new("Part")
	plate.Name = "Plate"
	plate.Size = Vector3.new(PORTAL_SIZE, PORTAL_SIZE, 0.2)
	-- the plate's LookVector IS the surface normal, which is what travel later
	-- reads as "out of the portal"
	plate.CFrame = CFrame.lookAt(position, position + normal, up)
	plate.Anchored = true
	plate.CanCollide = false
	plate.CanQuery = false -- so the next shot flies through a portal, not into it
	plate.CanTouch = false -- travel is a local box test, not a Touched event
	plate.CastShadow = false
	plate.Transparency = 1 -- the image is the only visible thing
	plate.Parent = model
	model.PrimaryPart = plate

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 64
	gui.LightInfluence = 0 -- a portal glows on its own
	gui.Brightness = 2
	gui.Parent = plate

	local image = Instance.new("ImageLabel")
	image.Name = "Image"
	image.Image = IMAGE_PORTAL
	image.BackgroundTransparency = 1
	image.AnchorPoint = Vector2.new(0.5, 0.5)
	image.Position = UDim2.fromScale(0.5, 0.5)
	image.Size = UDim2.fromScale(0, 0) -- opens below
	image.Parent = gui

	local light = Instance.new("PointLight")
	light.Color = YELLOW
	light.Brightness = 0
	light.Range = 0
	light.Shadows = false
	light.Parent = plate

	model.Parent = folder

	TweenService:Create(
		image,
		TweenInfo.new(OPEN_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(1, 1) }
	):Play()
	TweenService:Create(light, TweenInfo.new(OPEN_TIME), { Brightness = GLOW, Range = PORTAL_LIGHT_RANGE }):Play()
	playAt(position, "Open")

	local record = {
		id = id,
		n = n,
		owner = owner,
		model = model,
		plate = plate,
		image = image,
		light = light,
		open = false,
		bornAt = os.clock(),
	}
	portals[id] = record
	task.delay(OPEN_TIME, function()
		if not record.closing then
			record.open = true -- the visual pulse may start, and travel may fire
		end
	end)

	table.insert(pair.ids, id)
	return record
end

-- the glob of fluid, on its way to where the portal will open. Pure decoration:
-- the shot's outcome was decided by the shooter's raycast before this flew.
local function shootFluid(origin, landing, onArrival)
	local glob = Instance.new("Part")
	glob.Name = "PortalFluid"
	glob.Shape = Enum.PartType.Ball
	glob.Size = Vector3.one * 0.7
	glob.Material = Enum.Material.Neon
	glob.Color = YELLOW
	glob.CFrame = CFrame.new(origin)
	glob.Anchored = true
	glob.CanCollide = false
	glob.CanQuery = false
	glob.CanTouch = false
	glob.CastShadow = false

	local light = Instance.new("PointLight")
	light.Color = YELLOW
	light.Brightness = 3
	light.Range = 10
	light.Shadows = false
	light.Parent = glob

	-- a tail, so it reads as fluid thrown rather than a bullet
	local top, tail = Instance.new("Attachment"), Instance.new("Attachment")
	top.Position = Vector3.new(0, 0.3, 0)
	tail.Position = Vector3.new(0, -0.3, 0)
	top.Parent, tail.Parent = glob, glob
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = top, tail
	trail.Color = ColorSequence.new(YELLOW)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.22
	trail.LightEmission = 1
	trail.Parent = glob
	glob.Parent = folder

	local flight = math.max((landing - origin).Magnitude / FLUID_SPEED, 0.05)
	TweenService:Create(glob, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.new(landing) }):Play()
	Debris:AddItem(glob, flight + 1) -- the glob goes even if the shot is cut short
	task.delay(flight, function()
		glob:Destroy()
		if onArrival then
			onArrival()
		end
	end)
end

-- Both machines run this off the same `s` frame, so they open the same portal in
-- the same place with the same id. Portals no longer expire on a clock - they
-- stand until the third one pushes the oldest out, or until somebody clears.
local function arrive(owner, n, hit, position, normal)
	if not hit then
		return -- nothing solid out there: the fluid just goes
	end
	if not openPortal(owner, n, position, normal) then
		return
	end
	while #pair.ids > 2 do
		closePortal(pair.ids[1]) -- the oldest gives way; closePortal un-lists it
	end
end

-- The other open portal, whoever shot it. This is the change that lets one player
-- drop one end and the other player the other.
local function partner(record)
	for _, id in ipairs(pair.ids) do
		local other = portals[id]
		if other and other ~= record and other.open and not other.closing then
			return other
		end
	end
	return nil
end

local function clearPortals(announce)
	for index = #pair.ids, 1, -1 do
		closePortal(pair.ids[index])
	end
	table.clear(pair.ids)
	if announce then
		send("x")
	end
end

--=========================================================================
-- travel: only ever this machine's own character
--=========================================================================

-- Nothing in a portal is collidable - the plate is CanCollide false and CanQuery
-- false - so what stopped a floor portal working was the trigger, not a hitbox.
-- The old test was a point test at HumanoidRootPart, which on a floor portal sits
-- about three studs ABOVE the plate: standing right on one, the root was never
-- within the slab, so it never fired. Walls worked because there the root is at
-- the plate's own height.
--
-- So the character is treated as what it is: a standing segment from under the
-- feet to over the head, tested against the portal's slab as a box. Exact for a
-- floor, a ceiling, a wall and everything between, with no special casing.
local HALF = PORTAL_SIZE * 0.5

local function slab(origin, delta, half, tmin, tmax)
	if abs(delta) < 1e-6 then
		if abs(origin) > half then
			return nil, nil
		end
		return tmin, tmax
	end
	local t1, t2 = (-half - origin) / delta, (half - origin) / delta
	if t1 > t2 then
		t1, t2 = t2, t1
	end
	if t1 > tmin then
		tmin = t1
	end
	if t2 < tmax then
		tmax = t2
	end
	if tmin > tmax then
		return nil, nil
	end
	return tmin, tmax
end

local function segmentInBox(a, b, hx, hy, hz)
	local tmin, tmax = 0, 1
	tmin, tmax = slab(a.X, b.X - a.X, hx, tmin, tmax)
	if not tmin then
		return false
	end
	tmin, tmax = slab(a.Y, b.Y - a.Y, hy, tmin, tmax)
	if not tmin then
		return false
	end
	tmin, tmax = slab(a.Z, b.Z - a.Z, hz, tmin, tmax)
	return tmin ~= nil
end

local function insidePortal(record, top, bottom)
	local cf = record.plate.CFrame
	return segmentInBox(cf:PointToObjectSpace(top), cf:PointToObjectSpace(bottom), HALF, HALF, ENTER_DEPTH)
end

-- Anyone may use anyone's portals: this never checks who shot the one it steps
-- into. With one shared pair that is the whole point.
local function doTravel(record, exit, root)
	local out = exit.plate.CFrame.LookVector -- the exit surface's normal
	local flat = Vector3.new(out.X, 0, out.Z)
	-- a portal on a floor or a ceiling has no facing to give, so keep your own
	local facing = flat.Magnitude > 0.1 and flat.Unit or root.CFrame.LookVector
	local landing = exit.plate.Position + out * EXIT_OFFSET
	local speed = math.max(root.AssemblyLinearVelocity.Magnitude, EXIT_SPEED)

	root.CFrame = CFrame.lookAt(landing, landing + facing)
	root.AssemblyLinearVelocity = out * speed
	playAt(record.plate.Position, "Enter")
	playAt(exit.plate.Position, "Enter") -- both ends, which is what makes a pair
	                                     -- feel connected
end

local function travelStep()
	local character = LP.Character
	if not (character and character.Parent) then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not (humanoid and humanoid.Health > 0) then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	if not root then
		return
	end

	local now = os.clock()
	if (travelling[character] or 0) > now then
		return -- came out of a portal a moment ago; do not bounce straight back
	end

	-- the standing segment: HipHeight covers the legs on both rigs, and the extra
	-- stud each end covers the head and any small float above the floor
	local up = Vector3.yAxis
	local rootHalf = root.Size.Y * 0.5
	local top = root.Position + up * (rootHalf + 2)
	local bottom = root.Position - up * (rootHalf + (humanoid.HipHeight or 2) + 1)

	for _, id in ipairs(pair.ids) do
		local record = portals[id]
		if record and record.open and not record.closing and insidePortal(record, top, bottom) then
			local exit = partner(record)
			if exit then -- one portal on its own goes nowhere
				travelling[character] = now + TRAVEL_COOLDOWN
				doTravel(record, exit, root)
				send("t" .. record.owner .. "," .. record.n .. "," .. exit.n)
				return
			end
		end
	end
end

--=========================================================================
-- portal visuals (was PortalVisualsClient)
--=========================================================================

-- Sixty property updates a second each for something no two machines have to
-- agree on, so each does it for itself and none of it crosses the bridge. The
-- iteration is over the live record table rather than folder:GetChildren(), so
-- there is no allocation per frame.
local function visualStep(dt)
	local clock = os.clock()
	for _, record in pairs(portals) do
		if not record.closing then
			record.image.Rotation = (record.image.Rotation + SPIN_SPEED * dt) % 360
			if record.open then
				record.light.Brightness = GLOW * (1 + PULSE * math.sin(clock * PULSE_RATE))
			end
		end
	end
end

-- Portals have no clock any more. They stand until the third one pushes the
-- oldest out or somebody hits CLEAR, which is what the clear control is for.

--=========================================================================
-- the wire protocol
--=========================================================================
-- Terse on purpose: the aim frame goes 30 times a second and JSON would be four
-- times the bytes for no gain. One letter of kind, then integers.
--   client -> relay   a<p>,<y>,<b>                       aim
--                     s<n>,<mx,my,mz>,<lx,ly,lz>,<h>[,<nx,ny,nz>]   shot
--                     c<id>                              close one
--                     x                                  clear every portal
--                     t<owner>,<fromN>,<toN>             travel
--                     m<ammo>                            ammo
--                     e<0|1>                             equipped
--   relay -> client   the same frame with the sender's user id spliced in after
--                     the letter, so a client cannot claim to be the other one.
-- Angles are radians x 10000, positions studs x 100.

local HttpService = game:GetService("HttpService")
local floor = math.floor

local function q(n, scale)
	return tostring(floor(n * scale + 0.5))
end

local function packV3(v)
	return q(v.X, 100) .. "," .. q(v.Y, 100) .. "," .. q(v.Z, 100)
end

-- one reusable buffer: the aim path runs 30 times a second and should not be
-- handing the collector a new table each time
local fields = table.create(16)

local function split(text, from)
	local n = 0
	table.clear(fields)
	local length = #text
	while from <= length do
		local comma = string.find(text, ",", from, true)
		n += 1
		if comma then
			fields[n] = tonumber(string.sub(text, from, comma - 1))
			from = comma + 1
		else
			fields[n] = tonumber(string.sub(text, from))
			break
		end
	end
	return n
end

--=========================================================================
-- transport
--=========================================================================

local SOCKET_FACTORIES = {
	function()
		return WebSocket and WebSocket.connect
	end,
	function()
		return websocket and websocket.connect
	end,
	function()
		return syn and syn.websocket and syn.websocket.connect
	end,
	function()
		return Websocket and Websocket.connect
	end,
}

-- Executors do not agree on where the WebSocket lives or whether its methods are
-- called with a colon, so both are probed rather than assumed.
local function socketConnect(url)
	for _, factory in ipairs(SOCKET_FACTORIES) do
		local ok, connect = pcall(factory)
		if ok and type(connect) == "function" then
			local opened, socket = pcall(connect, url)
			if opened and socket then
				return socket
			end
			log("connect failed:", socket)
		end
	end
	return nil
end

local function socketSend(socket, text)
	if socket.Send then
		local ok = pcall(socket.Send, socket, text)
		if ok then
			return true
		end
		return pcall(socket.Send, text)
	end
	if socket.send then
		return pcall(socket.send, socket, text)
	end
	return false
end

local URL = (CONFIG.TLS and "wss://" or "ws://") .. CONFIG.HOST .. ":" .. CONFIG.PORT

local socket = nil
local connected = false
local peers = {} -- userId -> peer state
local onFrame -- assigned below, once the handlers exist

send = function(text)
	if connected and socket then
		socketSend(socket, text)
	end
end

local statusLabel -- the HUD's connection line, built further down

local function setStatus(text, colour)
	if statusLabel then
		statusLabel.Text = text
		statusLabel.TextColor3 = colour
	end
end

local function handshake()
	return HttpService:JSONEncode({
		t = "hello",
		v = 1,
		room = CONFIG.ROOM,
		token = CONFIG.TOKEN,
		uid = LP.UserId,
		name = LP.Name,
		-- JobId is replicated, so this one is real: the relay refuses a room whose
		-- two members report different server instances, which is the check that
		-- actually stops a room bridging two places together.
		job = game.JobId,
		place = game.PlaceId,
		-- these two are "" and 0 from a client; sent anyway so a future server-fed
		-- build needs no protocol change
		ps = PRIVATE_ID,
		owner = PRIVATE_OWNER,
		ts = os.time(),
		nonce = HttpService:GenerateGUID(false),
	})
end

local function dropPeer(userId)
	local peer = peers[userId]
	if not peer then
		return
	end
	peers[userId] = nil
	-- their end of the pair goes with them: nothing here can re-sync a portal
	-- whose owner has left
	for index = #pair.ids, 1, -1 do
		local record = portals[pair.ids[index]]
		if record and record.owner == userId then
			closePortal(record.id)
		end
	end
	if peer.character then
		local holder = holders[peer.character]
		if holder then
			detach(holder)
			holder.wantBlend = 0
			holder.equipped = false
		end
	end
end

-- Peers are found by user id, not by name, and their character is re-resolved
-- each time rather than cached across a respawn.
local function peerHolder(userId)
	local peer = peers[userId]
	if not peer then
		peer = {}
		peers[userId] = peer
	end
	local player = peer.player
	if not (player and player.Parent) then
		player = Players:GetPlayerByUserId(userId)
		peer.player = player
	end
	if not player then
		return nil, peer
	end
	local character = player.Character
	if not (character and character.Parent) then
		return nil, peer
	end
	peer.character = character
	return holderFor(character), peer
end

local function onControl(text)
	local ok, message = pcall(HttpService.JSONDecode, HttpService, text)
	if not (ok and type(message) == "table") then
		return
	end
	if message.t == "welcome" then
		connected = true
		setStatus("bridged  ." .. CONFIG.ROOM, Color3.fromRGB(120, 235, 140))
		log("welcome, peers:", message.peers and #message.peers or 0)
		-- tell whoever is already in the room where we stand
		send("e" .. (holders[LP.Character] and holders[LP.Character].equipped and 1 or 0))
	elseif message.t == "leave" and message.uid then
		dropPeer(message.uid)
	elseif message.t == "error" then
		connected = false
		setStatus("relay refused: " .. tostring(message.m), Color3.fromRGB(240, 120, 120))
		warn("[PortalBridge] relay refused the handshake: " .. tostring(message.m))
	end
end

onFrame = function(text)
	if type(text) ~= "string" or #text < 2 then
		return
	end
	local kind = string.byte(text, 1)

	if kind == 123 then -- '{' : the control channel is the only JSON on the wire
		return onControl(text)
	end

	local n = split(text, 2)
	local userId = fields[1]
	if not userId or userId == LP.UserId then
		return -- the relay does not echo, but never trust that
	end

	if kind == 97 then -- 'a' aim
		if n < 4 then
			return
		end
		local holder = peerHolder(userId)
		if holder then
			holder.wantPitch = fields[2] / 10000
			holder.wantYaw = fields[3] / 10000
			holder.wantBlend = fields[4] / 255
			holder.pointAt = os.clock()
		end
	elseif kind == 101 then -- 'e' equipped
		local holder, peer = peerHolder(userId)
		local on = fields[2] == 1
		peer.equipped = on
		if holder then
			holder.equipped = on
			if on then
				attach(holder)
			else
				detach(holder)
				holder.wantBlend = 0
			end
		end
	elseif kind == 109 then -- 'm' ammo
		local holder, peer = peerHolder(userId)
		peer.ammo = fields[2]
		if holder then
			holder.ammo = fields[2]
			if holder.count then
				holder.count.Text = tostring(fields[2])
			end
		end

	elseif kind == 115 then -- 's' shot: the shooter already decided the outcome,
		if n < 9 then      -- so this replays it rather than raycasting again and
			return         -- risking a different answer on each machine
		end
		local portalN = fields[2]
		local muzzle = Vector3.new(fields[3] / 100, fields[4] / 100, fields[5] / 100)
		local landing = Vector3.new(fields[6] / 100, fields[7] / 100, fields[8] / 100)
		local hit = fields[9] == 1
		local normal = hit and n >= 12 and Vector3.new(fields[10] / 1000, fields[11] / 1000, fields[12] / 1000)
			or Vector3.yAxis
		shootFluid(muzzle, landing, function()
			arrive(userId, portalN, hit, landing + normal * SURFACE_OFFSET, normal)
		end)
	elseif kind == 99 then -- 'c' close one
		closePortal(userId .. ":" .. fields[2])
	elseif kind == 120 then -- 'x' clear every portal, both ends of the bridge
		clearPortals(false)
	elseif kind == 116 then -- 't' travel: the traveller moved itself, and its own
		if n < 4 then       -- CFrame write replicates, so this is only the sound
			return           -- at both ends
		end
		local owner = fields[2]
		local from = portals[owner .. ":" .. fields[3]]
		local to = portals[owner .. ":" .. fields[4]]
		if from then
			playAt(from.plate.Position, "Enter")
		end
		if to then
			playAt(to.plate.Position, "Enter")
		end
	end
end

local function pump(sock)
	local ok, signal = pcall(function()
		return sock.OnMessage or sock.onMessage or sock.OnMessageReceived
	end)
	if ok and signal then
		keep(signal:Connect(function(text)
			local fine, err = pcall(onFrame, text)
			if not fine then
				log("frame error:", err)
			end
		end))
	end
	local shut
	ok, shut = pcall(function()
		return sock.OnClose or sock.onClose
	end)
	if ok and shut then
		keep(shut:Connect(function()
			connected = false
			socket = nil
			setStatus("relay dropped - retrying", Color3.fromRGB(240, 190, 110))
		end))
	end
end

task.spawn(function()
	while alive do
		if not socket then
			setStatus("dialling " .. CONFIG.HOST .. " ...", Color3.fromRGB(240, 190, 110))
			local sock = socketConnect(URL)
			if sock then
				socket = sock
				pump(sock)
				socketSend(sock, handshake()) -- the relay answers with `welcome`
				                              -- or `error`, which sets `connected`
			else
				setStatus("no WebSocket in this executor", Color3.fromRGB(240, 120, 120))
			end
		end
		task.wait(CONFIG.RECONNECT)
	end
end)

--=========================================================================
-- the local player: the Tool, the aim, the trigger
--=========================================================================

local ammo = START_AMMO
local lastShot = 0
local shotCounter = 0
local equipped = false
local sinceSend = 0
local published = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local shotParams = RaycastParams.new()
shotParams.FilterType = Enum.RaycastFilterType.Exclude
shotParams.IgnoreWater = true

local shootButton -- built by the HUD, dimmed when the gun runs dry
local clearButton

local function setAmmo(value)
	ammo = math.clamp(value, 0, START_AMMO)
	local holder = LP.Character and holders[LP.Character]
	if holder then
		holder.ammo = ammo
		if holder.count then
			holder.count.Text = tostring(ammo)
		end
	end
	send("m" .. ammo)
	if shootButton then
		shootButton.BackgroundTransparency = ammo <= 0 and 0.6 or 0.15
		shootButton.TextTransparency = ammo <= 0 and 0.55 or 0
	end
end

-- Studio streamed the cursor point to the server and let it work out the angles.
-- Here the owner does both, then sends the finished angles instead of the point -
-- one frame rather than a round trip, and the peer has nothing to recompute.
local function senderStep()
	local character = LP.Character
	if not character then
		return
	end
	local holder = holderFor(character)
	if not holder then
		return
	end

	local camera = workspace.CurrentCamera
	if equipped and camera then
		-- With the gun out the mouse may be held in the middle of the screen, and a
		-- touchscreen has no cursor at all, so the aim comes from the middle of the
		-- viewport - the same spot the crosshair is drawn on.
		local cursor
		if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter or not UserInputService.MouseEnabled then
			cursor = camera.ViewportSize * 0.5
		else
			cursor = UserInputService:GetMouseLocation() -- excludes the topbar inset,
			                                            -- as ViewportPointToRay does
		end
		local ray = camera:ViewportPointToRay(cursor.X, cursor.Y)
		rayParams.FilterDescendantsInstances = { character, folder }
		local hit = workspace:Raycast(ray.Origin, ray.Direction * AIM_RANGE, rayParams)
		holder.point = hit and hit.Position or ray.Origin + ray.Direction * AIM_RANGE
		holder.pointAt = os.clock()
	end

	local wantPitch, wantYaw, wantBlend = 0, 0, 0
	if equipped and holder.point and os.clock() - holder.pointAt <= STALE_AFTER then
		local torsoCF = holder.rig.torso.CFrame
		local offset = holder.point - armAnchor(holder.rig, torsoCF)
		if offset.Magnitude > 0.5 then
			local direction = torsoCF:VectorToObjectSpace(offset.Unit)
			-- +pitch is up, +yaw is toward the character's left; the torso's +X is
			-- its right and its +Z is backwards
			wantYaw = clampYaw(atan2(-direction.X, -direction.Z), holder.yaw)
			wantPitch = clamp(asin(clamp(direction.Y, -1, 1)), -MAX_PITCH, MAX_PITCH)
			wantBlend = 1
		end
	end
	holder.wantPitch, holder.wantYaw, holder.wantBlend = wantPitch, wantYaw, wantBlend

	-- a parked cursor sends nothing: below ~0.23 degrees it is not worth the frame
	local target = Vector3.new(wantPitch, wantYaw, wantBlend)
	if not published or (published - target).Magnitude > PUBLISH_EPSILON then
		published = target
		send("a" .. q(wantPitch, 10000) .. "," .. q(wantYaw, 10000) .. "," .. q(wantBlend, 255))
	end
end

local function fire()
	local character = LP.Character
	local holder = character and holders[character]
	if not (equipped and holder) then
		return
	end
	local now = os.clock()
	if lastShot + SHOT_COOLDOWN > now or ammo <= 0 then
		return
	end
	if not (holder.point and now - holder.pointAt <= STALE_AFTER) then
		return -- no fresh idea of where they are pointing
	end
	local barrel = holder.barrel
	if not (barrel and barrel.Parent) then
		return
	end

	-- the gun's +X is the muzzle; see GRIP_ROT
	local muzzle = (barrel.CFrame * CFrame.new(barrel.Size.X * 0.5 + 0.2, 0, 0)).Position
	local offset = holder.point - muzzle
	if offset.Magnitude < 1 then
		return
	end

	lastShot = now
	setAmmo(ammo - 1) -- the spend is unconditional: a shot into the sky costs a
	                  -- round, which is the intended feel for a fluid

	shotParams.FilterDescendantsInstances = { character, folder }
	local hit = workspace:Raycast(muzzle, offset.Unit * RANGE, shotParams)
	if hit then
		-- a portal needs a surface that stays put, not somebody's leg
		local model = hit.Instance:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			hit = nil
		end
	end

	shotCounter += 1
	local n = shotCounter
	local landing = hit and hit.Position or muzzle + offset.Unit * RANGE
	local normal = hit and hit.Normal or Vector3.yAxis

	local frame = "s" .. n .. "," .. packV3(muzzle) .. "," .. packV3(landing) .. "," .. (hit and 1 or 0)
	if hit then
		frame = frame .. "," .. q(normal.X, 1000) .. "," .. q(normal.Y, 1000) .. "," .. q(normal.Z, 1000)
	end
	send(frame)

	shootFluid(muzzle, landing, function()
		-- the 0.1 stud offset is why a shot at the crosshair measures 0.10 studs
		-- from the point under it: the plate floats deliberately that far off
		arrive(LP.UserId, n, hit ~= nil, landing + normal * SURFACE_OFFSET, normal)
	end)
end

--=========================================================================
-- the Tool
--=========================================================================

local tool = nil

local function buildTool()
	if tool then
		tool:Destroy()
	end
	local backpack = LP:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	tool = keep(Instance.new("Tool"))
	tool.Name = "PortalGun"
	-- no Handle at all: give a Tool one and the engine builds its own RightGrip
	-- weld on equip, and two joints owning the same part make the gun jitter
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Golden Portal Gun"
	tool:SetAttribute("PortalGun", true)

	hook(tool.Equipped, function()
		equipped = true
		local holder = LP.Character and holderFor(LP.Character)
		if holder then
			holder.equipped = true
			attach(holder)
		end
		published = nil
		send("e1")
		setAmmo(ammo)
	end)

	hook(tool.Unequipped, function()
		equipped = false
		local holder = LP.Character and holders[LP.Character]
		if holder then
			holder.equipped = false
			holder.wantBlend = 0
			detach(holder)
		end
		published = nil
		send("e0")
	end)

	hook(tool.Activated, fire)
	tool.Parent = backpack
end

--=========================================================================
-- HUD: the crosshair, the connection line, and a trigger for touchscreens
--=========================================================================

local TOUCH_CAPABLE = UserInputService.TouchEnabled
local usingTouch = TOUCH_CAPABLE and not UserInputService.MouseEnabled
local hud, cursorFrame

local function buildHud()
	local old = LP.PlayerGui:FindFirstChild("PortalBridgeHud")
	if old then
		old:Destroy()
	end
	hud = keep(Instance.new("ScreenGui"))
	hud.Name = "PortalBridgeHud"
	hud.ResetOnSpawn = false
	hud.DisplayOrder = 5
	hud.IgnoreGuiInset = false
	pcall(function()
		-- a notch or a home bar pushes the button in rather than sitting on it
		hud.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	end)
	hud.Parent = LP.PlayerGui

	statusLabel = Instance.new("TextLabel")
	statusLabel.Name = "Status"
	statusLabel.AnchorPoint = Vector2.new(0, 0)
	statusLabel.Position = UDim2.fromOffset(12, 12)
	statusLabel.Size = UDim2.fromOffset(320, 18)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.Code
	statusLabel.TextSize = 14
	statusLabel.TextXAlignment = Enum.TextXAlignment.Left
	statusLabel.TextStrokeTransparency = 0.4
	statusLabel.Text = ""
	statusLabel.Parent = hud

	-- the crosshair, since StarterGui.Cursor is a place asset the executor has not
	-- got. On a mouse it follows the pointer; on a touchscreen it pins to the
	-- middle, which is where the aim comes from there.
	cursorFrame = Instance.new("ImageLabel")
	cursorFrame.Name = "Cursor"
	cursorFrame.Image = IMAGE_CURSOR
	cursorFrame.Size = UDim2.fromOffset(10, 10)
	cursorFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	cursorFrame.BackgroundTransparency = 1
	cursorFrame.ScaleType = Enum.ScaleType.Stretch
	cursorFrame.ZIndex = 5
	cursorFrame.Visible = false
	cursorFrame.Parent = hud

	if TOUCH_CAPABLE then
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1024, 768)
		local side = clamp(math.min(viewport.X, viewport.Y) * 0.18, 84, 150)
		local IDLE = Color3.fromRGB(222, 222, 222)

		-- One shape for both controls, stacked up the right edge. The very corner
		-- belongs to Roblox's jump button, hence the first lift.
		local function circle(name, label, row, onClick)
			local button = Instance.new("TextButton")
			button.Name = name
			button.AnchorPoint = Vector2.new(1, 1)
			button.Position = UDim2.new(1, -24, 1, -floor(side * 1.35 + 24 + row * (side + 14)))
			button.Size = UDim2.fromOffset(side, side)
			button.BackgroundColor3 = IDLE
			button.BackgroundTransparency = 0.15
			button.AutoButtonColor = false -- the flash is the only colour change
			button.Text = label
			button.TextColor3 = Color3.fromRGB(25, 25, 25)
			button.Font = Enum.Font.GothamBold
			button.TextSize = floor(side * 0.22)
			button.Visible = false
			button.Parent = hud

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = button

			hook(button.MouseButton1Down, function()
				button.BackgroundColor3 = BUTTON_YELLOW
			end)
			local function unpress()
				button.BackgroundColor3 = IDLE
			end
			hook(button.MouseButton1Up, unpress)
			hook(button.MouseLeave, unpress)
			hook(button.MouseButton1Click, onClick)
			return button
		end

		shootButton = circle("Shoot", "SHOOT", 0, fire) -- the same path a click pulls
		clearButton = circle("Clear", "CLEAR", 1, function()
			clearPortals(true)
		end)
	end
end

local iconHidden = false

local function hudStep()
	if not cursorFrame then
		return
	end
	cursorFrame.Visible = equipped
	local onTouch = equipped and usingTouch
	if shootButton then
		shootButton.Visible = onTouch
	end
	if clearButton then
		clearButton.Visible = onTouch
	end
	-- the system cursor goes only while our own crosshair is up, so an unequipped
	-- player is not left with no pointer at all
	if equipped ~= iconHidden then
		iconHidden = equipped
		UserInputService.MouseIconEnabled = not equipped
	end
	if not equipped then
		return
	end
	if usingTouch or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		local camera = workspace.CurrentCamera
		if camera then
			-- this ScreenGui's canvas starts below the topbar, so the inset comes off
			local middle = camera.ViewportSize * 0.5 - GuiService:GetGuiInset()
			cursorFrame.Position = UDim2.fromOffset(middle.X, middle.Y)
		end
	else
		local at = UserInputService:GetMouseLocation()
		cursorFrame.Position = UDim2.fromOffset(at.X, at.Y)
	end
end

-- A tablet with a keyboard case reports a keyboard and a mouse as well as touch,
-- and so does Studio's emulator, so `TouchEnabled and not KeyboardEnabled` never
-- fires. Whichever the player last used wins instead.
local function isTouch(inputType)
	return inputType == Enum.UserInputType.Touch
		or inputType == Enum.UserInputType.Gyro
		or inputType == Enum.UserInputType.Accelerometer
end

if TOUCH_CAPABLE then
	if isTouch(UserInputService:GetLastInputType()) then
		usingTouch = true
	end
	hook(UserInputService.LastInputTypeChanged, function(inputType)
		if isTouch(inputType) then
			usingTouch = true
		elseif
			inputType == Enum.UserInputType.MouseMovement
			or inputType == Enum.UserInputType.MouseButton1
			or inputType == Enum.UserInputType.MouseButton2
			or inputType == Enum.UserInputType.MouseWheel
			or inputType == Enum.UserInputType.Keyboard
		then
			usingTouch = false
		end
	end)
end

-- T clears both ends of the bridge, since portals no longer time out. Checking
-- gameProcessed is what keeps it from firing while the chat bar has the keyboard.
hook(UserInputService.InputBegan, function(input, processed)
	if processed or not alive then
		return
	end
	if input.KeyCode == CLEAR_KEY then
		clearPortals(true)
	end
end)

--=========================================================================
-- lives
--=========================================================================

local function onCharacter(character)
	equipped = false
	published = nil
	ammo = START_AMMO -- a fresh life, a full gun
	-- the Backpack is rebuilt on respawn, so the Tool has to be too
	task.defer(function()
		if alive then
			buildTool()
			setAmmo(ammo)
			send("e0")
		end
	end)
	character.AncestryChanged:Once(function()
		local holder = holders[character]
		if holder then
			detach(holder)
			holders[character] = nil
		end
	end)
end

hook(LP.CharacterAdded, onCharacter)
if LP.Character then
	onCharacter(LP.Character)
end

hook(Players.PlayerRemoving, function(player)
	dropPeer(player.UserId)
end)

--=========================================================================
-- the loops
--=========================================================================

local sendInterval = 1 / clamp(CONFIG.SEND_RATE, 5, 60)
local sincePeers = 0

-- PreSimulation: after the Animator has evaluated this frame, before physics
-- moves anything. Everything that writes a joint has to be here - on
-- PostSimulation the next frame's animation overwrites the write.
-- PreSimulation passes (dt); the older Stepped passes (time, dt).
local okPre, preSignal = pcall(function()
	return RunService.PreSimulation
end)
local stepSignal = okPre and preSignal or nil
local stepIsPre = stepSignal ~= nil
stepSignal = stepSignal or RunService.Stepped

hook(stepSignal, function(a, b)
	if not alive then
		return
	end
	local dt = (stepIsPre and a or b) or 1 / 60
	sinceSend += dt
	if sinceSend >= sendInterval then
		sinceSend = 0
		senderStep()
	end
	poseStep(dt)
end)

-- A peer's `e1` can land before its character exists on this machine, and its
-- character is rebuilt on every respawn, so the gun is re-checked rather than
-- attached once and hoped for.
local function peerStep()
	for userId, peer in pairs(peers) do
		if peer.equipped then
			local holder = peerHolder(userId)
			if holder then
				holder.equipped = true
				if not holder.motor then
					holder.ammo = peer.ammo
					attach(holder)
				end
			end
		end
	end
end

-- travel is a physics answer, so it reads the world after physics has moved it
hook(RunService.Heartbeat, function(dt)
	if not alive then
		return
	end
	travelStep()
	sincePeers += dt
	if sincePeers >= 0.1 then
		sincePeers = 0
		peerStep()
	end
end)

hook(RunService.RenderStepped, function(dt)
	if not alive then
		return
	end
	visualStep(dt)
	hudStep()
end)

--=========================================================================
-- teardown
--=========================================================================

function Bridge.stop()
	if not alive then
		return
	end
	alive = false

	for character, holder in pairs(holders) do
		pcall(detach, holder)
		holders[character] = nil
	end
	for id in pairs(portals) do
		local record = portals[id]
		portals[id] = nil
		pcall(function()
			record.model:Destroy()
		end)
	end
	table.clear(pair.ids)
	table.clear(peers)

	if socket then
		pcall(function()
			if socket.Close then
				socket:Close()
			elseif socket.close then
				socket:close()
			end
		end)
		socket = nil
	end
	connected = false

	for i = #bin, 1, -1 do
		local item = bin[i]
		bin[i] = nil
		pcall(function()
			if typeof(item) == "RBXScriptConnection" then
				item:Disconnect()
			else
				item:Destroy()
			end
		end)
	end

	UserInputService.MouseIconEnabled = true
	statusLabel, shootButton, clearButton, cursorFrame, hud, tool = nil, nil, nil, nil, nil, nil
	print("[PortalBridge] stopped")
end



