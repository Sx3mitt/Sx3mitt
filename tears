local function getBlockingEnemyInFront()
    local myChar = LocalPlayer.Character
    local myHRP = getHRP(myChar)
    if not myHRP then return nil end

    local bestEnemy = nil
    local bestDist = _G.BlockBreakState.Distance
    
    local charsFolder = Workspace:FindFirstChild("Characters")
    local entities = charsFolder and charsFolder:GetChildren() or {}
    if #entities == 0 then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(entities, p.Character) end
        end
    end

    for _, tChar in ipairs(entities) do
        if tChar:IsA("Model") and tChar ~= myChar then
            local tHRP = getHRP(tChar)
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            if tHRP and tHum and tHum.Health > 0 then
                local dist = (myHRP.Position - tHRP.Position).Magnitude
                if dist <= bestDist then
                    local toEnemy = (tHRP.Position - myHRP.Position).Unit
                    local dot = myHRP.CFrame.LookVector:Dot(toEnemy)
                    if dot > 0.3 then
                        local animator = tHum:FindFirstChild("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                local animId = track.Animation and track.Animation.AnimationId
                                if BB_BLOCK_ANIMS[animId] then
                                    bestDist = dist
                                    bestEnemy = tChar
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestEnemy
end

local function performBlockBreakDash(targetChar)
    if _G.BlockBreakState.IsDashing then return end
    
    local myChar = LocalPlayer.Character
    local myHRP = getHRP(myChar)
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local tHRP = getHRP(targetChar)
    if not (myHRP and hum and tHRP) then return end

    _G.BlockBreakState.IsDashing = true
    if _G.BlockBreakState.DashConn then _G.BlockBreakState.DashConn:Disconnect() end

    local startTime = tick()
    local startPos = Vector3.new(myHRP.Position.X, 0, myHRP.Position.Z)
    
    local fixedEndPos = getBehindPos(tHRP, myHRP.Position.Y, _G.BlockBreakState.Radius)
    fixedEndPos = Vector3.new(fixedEndPos.X, 0, fixedEndPos.Z)

    local function getSideControlPoint(targetPos)
        local rightVec = Vector3.new(tHRP.CFrame.RightVector.X, 0, tHRP.CFrame.RightVector.Z).Unit
        local toPlayer = Vector3.new(myHRP.Position.X, 0, myHRP.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)
        local sideSign = toPlayer:Dot(rightVec) >= 0 and 1 or -1
        return Vector3.new(targetPos.X, 0, targetPos.Z) + rightVec * (_G.BlockBreakState.CurveStrength * sideSign)
    end

    local controlPt = getSideControlPoint(tHRP.Position)
    hum.AutoRotate = false

    local dashSound = Instance.new("Sound")
    dashSound.SoundId = "rbxassetid://3929467229"
    dashSound.Parent = myHRP
    dashSound:Play()
    game:GetService("Debris"):AddItem(dashSound, 2)

    local clonedTrail = nil
    pcall(function()
        local template = game:GetService("ReplicatedStorage").Utils.Misc.SmokeTrail
        clonedTrail = template:Clone()
        clonedTrail.CFrame = myHRP.CFrame * CFrame.new(0, -2.5, 0) 
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = myHRP
        weld.Part1 = clonedTrail
        weld.Parent = clonedTrail
        
        clonedTrail.Parent = myChar
    end)

    _G.BlockBreakState.DashConn = RunService.Heartbeat:Connect(function()
        local linearAlpha = math.clamp((tick() - startTime) / _G.BlockBreakState.Duration, 0, 1)
        local easedAlpha = easeOutCubic(linearAlpha)
        
        if linearAlpha >= 1 or not tHRP.Parent then
            _G.BlockBreakState.DashConn:Disconnect()
            _G.BlockBreakState.IsDashing = false
            
            if clonedTrail then clonedTrail:Destroy() end
            
            if _G.BlockBreakState.LockBehind then
                local endTime = tick() + 0.35
                local lockConn
                lockConn = RunService.Heartbeat:Connect(function()
                    if tick() >= endTime or not tHRP.Parent or hum.Health <= 0 then
                        lockConn:Disconnect()
                        hum.AutoRotate = true
                    else
                        myHRP.CFrame = CFrame.lookAt(myHRP.Position, Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z))
                    end
                end)
                table.insert(_G.BlockBreakState.Connections, lockConn)
            else
                hum.AutoRotate = true
            end
            return
        end
        
        local blendedControl = Vector3.new(
            controlPt.X * (1 - easedAlpha) + fixedEndPos.X * easedAlpha,
            0,
            controlPt.Z * (1 - easedAlpha) + fixedEndPos.Z * easedAlpha
        )
        local t = 1 - (1 - easedAlpha)^2
        local t1 = 1 - t
        local movePos = Vector3.new(
            (t1*t1)*startPos.X + (2*t1*t)*blendedControl.X + (t*t)*fixedEndPos.X,
            myHRP.Position.Y,
            (t1*t1)*startPos.Z + (2*t1*t)*blendedControl.Z + (t*t)*fixedEndPos.Z
        )
        
        if _G.BlockBreakState.LockBehind then
            myHRP.CFrame = CFrame.new(movePos, Vector3.new(tHRP.Position.X, movePos.Y, tHRP.Position.Z))
        else
            myHRP.CFrame = CFrame.new(movePos) * (myHRP.CFrame - myHRP.CFrame.Position)
        end
    end)
end

local function setupBlockBreakAnimDetection(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    
    local animator = humanoid:WaitForChild("Animator", 10)
    if not animator then return end
    
    local animConnection = animator.AnimationPlayed:Connect(function(animationTrack)
        if not _G.BlockBreakState.Enabled or _G.BlockBreakState.IsDashing then return end
        
        local animId = animationTrack.Animation and animationTrack.Animation.AnimationId or ""
        if BB_M1_ANIMS[animId] then
            local target = getBlockingEnemyInFront()
            if target then
                performBlockBreakDash(target)
            end
        end
    end)
    table.insert(_G.BlockBreakState.Connections, animConnection)
end

