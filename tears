local function runAcBypass(state)
    _G.AutoKillState.acActive = state
    if not state then
        updateACStatus("Idle")
        return
    end

    task.spawn(function()
        local attempts = 0
        
        -- Helper function to safely teleport to coordinates
        local function teleportToCoord(vec)
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                root.CFrame = CFrame.new(vec)
                return true
            end
            return false
        end
        
        -- The coordinates you provided
        local testCoord = Vector3.new(-30.5004654, 23.4476242, -65.0752106)
        local verifyCoord = Vector3.new(-347.312103, 61.6716843, -346.053009)

        while _G.AutoKillState.acActive do
            local startingCFrame = getLocalRootCFrame()
            if not startingCFrame then
                task.wait(1)
            else
                attempts = attempts + 1
                updateACStatus("Attempt " .. attempts .. "  Testing bypass coordinates")
                
                -- Teleport to first coordinate
                if teleportToCoord(testCoord) then
                    task.wait(0.35)
                    
                    if checkRubberBand(startingCFrame) then
                        updateACStatus("Rubber-banded - resetting...")
                        local oldChar = LocalPlayer.Character
                        triggerNetworkReset()
                        waitForCharacterRespawn(oldChar)
                    else
                        -- Potential Success detected, verify it's not a fluke
                        updateACStatus("Verifying bypass...")
                        
                        local preVerifyCFrame = getLocalRootCFrame()
                        
                        -- Teleport to verify coordinate
                        if teleportToCoord(verifyCoord) then
                            task.wait(0.8) -- Wait a little longer to ensure AC response has time
                            
                            -- If we rubberband back to the very start OR the intermediate point, it's a fluke
                            if checkRubberBand(startingCFrame) or checkRubberBand(preVerifyCFrame) then
                                updateACStatus("Fluke detected - resetting...")
                                local oldChar = LocalPlayer.Character
                                triggerNetworkReset()
                                waitForCharacterRespawn(oldChar)
                            else
                                -- Verified Success
                                updateACStatus("AC Bypassed")
                                
                                task.wait(0.5)
                                
                                local cleanChar = LocalPlayer.Character
                                if cleanChar and cleanChar:FindFirstChild("HumanoidRootPart") then
                                    cleanChar.HumanoidRootPart.CFrame = startingCFrame
                                end
                                
                                _G.AutoKillState.acActive = false
                                break
                            end
                        else
                            task.wait(0.5)
                        end
                    end
                else
                    task.wait(0.5)
                end
            end
        end
    end)
end

