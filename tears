                        _G.StandState.IsAbusing = true
                        task.spawn(function() StartAbusingTarget(newChar) end)
                    end
                end
            end
        end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if _G.StandState.Conns.Render and myRoot and not _G.StandState.IsPerformingAction then
            if _G.StandState.IntendedState == "Attached" or _G.StandState.IntendedState == "Aura" then
                if _G.StandState.MainTarget and _G.StandState.MainTarget:FindFirstChild("HumanoidRootPart") then
                    local tRoot = _G.StandState.MainTarget.HumanoidRootPart
                    if (myRoot.Position - tRoot.Position).Magnitude > 50 then
                        DetachAll()
                        task.wait(0.1)
                        _G.StandState.IsAttaching = true
                        if _G.StandState.IntendedState == "Aura" then
                            _G.StandState.IsAuraActive = true
                            StartAuraLoop()
                        end
                        task.spawn(function() AttachToTarget(_G.StandState.MainTarget) end)
                    end
                end
            elseif _G.StandState.IntendedState == "Abusing" then
                if _G.StandState.UtilTarget and _G.StandState.UtilTarget:FindFirstChild("HumanoidRootPart") then
                    local tRoot = _G.StandState.UtilTarget.HumanoidRootPart
                    if (myRoot.Position - tRoot.Position).Magnitude > 50 then
                        DetachAll()
                        task.wait(0.1)
                        _G.StandState.IsAbusing = true
                        task.spawn(function() StartAbusingTarget(_G.StandState.UtilTarget) end)
                    end
                end
            end
        end
    end
end)

