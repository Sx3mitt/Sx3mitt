local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
if isMobile then
    local guiName = "Sedse_Mobile_Menu_Controls"
    local coreGui = pcall(function() return game:GetService("CoreGui").Name end) and game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")
    
    local existing = coreGui:FindFirstChild(guiName)
    if existing then existing:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = guiName
    sg.ResetOnSpawn = false
    sg.Parent = coreGui

    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 110, 0, 35) 
    container.Position = UDim2.new(0, 10, 0, 50) 
    container.BackgroundTransparency = 1
    container.Active = true
    container.Parent = sg

    -- Define the custom font object
    local customFont = Font.new("rbxassetid://12187375716", Enum.FontWeight.Regular, Enum.FontStyle.Normal)

    local toggleMenuBtn = Instance.new("TextButton")
    toggleMenuBtn.Size = UDim2.new(1, 0, 1, 0)
    toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35) 
    toggleMenuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleMenuBtn.FontFace = customFont 
    toggleMenuBtn.TextSize = 15
    toggleMenuBtn.Text = "Toggle Menu"
    toggleMenuBtn.Parent = container

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 6)
    toggleCorner.Parent = toggleMenuBtn

    -- Perfectly Smooth Draggable Logic (Drag vs Click Detection)
    local dragging = false
    local isDraggingAction = false
    local dragStart, startPos
    
    toggleMenuBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            isDraggingAction = false
            dragStart = input.Position
            startPos = container.Position
        end
    end)
    
    toggleMenuBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            -- Reset drag state after a tiny delay so the click event has time to read it
            task.delay(0.1, function()
                isDraggingAction = false
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            -- If moved more than 5 pixels, consider it a drag and NOT a click
            if delta.Magnitude > 5 then
                isDraggingAction = true
            end
            container.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    toggleMenuBtn.MouseButton1Click:Connect(function()
        -- Only toggle the menu if the user tapped (didn't drag)
        if not isDraggingAction then
            if win and win.toggle_menu then
                win.toggle_menu()
            end
        end
    end)
end

win:RefreshMobileList()
end
