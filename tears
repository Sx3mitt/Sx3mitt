local function SafeFireBlockActivated()
    if _G.AutoBlockState.GlobalBlockCount == 0 then
        if BlockActivatedRemote then pcall(function() BlockActivatedRemote:FireServer() end) end
    end
    _G.AutoBlockState.GlobalBlockCount = _G.AutoBlockState.GlobalBlockCount + 1
end

local function SafeFireBlockDeactivated()
    _G.AutoBlockState.GlobalBlockCount = math.max(0, _G.AutoBlockState.GlobalBlockCount - 1)
    if _G.AutoBlockState.GlobalBlockCount == 0 then
        if BlockDeactivatedRemote then pcall(function() BlockDeactivatedRemote:FireServer() end) end
    end
end

-- ================= Trail M1 Block =================
local function triggerBlock()
    if not _G.AutoBlockState.Enabled or _G.AutoBlockState.IsOnCooldown then return end
    if not BlockActivatedRemote or not BlockDeactivatedRemote then return end

    _G.AutoBlockState.IsOnCooldown = true
    
    task.spawn(function()
        SafeFireBlockActivated()
        task.wait(ABSettings.BlockDuration)
        SafeFireBlockDeactivated()
        task.wait(ABSettings.CooldownTime)
        _G.AutoBlockState.IsOnCooldown = false
    end)
end

local activeTrails = {}

local function checkPart(child)
    if not child or child.Name ~= "CombatTrail" or not child:IsA("BasePart") then return end
    table.insert(activeTrails, child)
    
    child.Destroying:Connect(function()
        for i, trail in ipairs(activeTrails) do
            if trail == child then
                table.remove(activeTrails, i)
                break
            end
        end
    end)
end

local function checkActiveTrails()
    if not _G.AutoBlockState.Enabled or _G.AutoBlockState.IsOnCooldown then return end
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, trail in ipairs(activeTrails) do
        if trail.Parent then
            local vectorToTrail = trail.Position - hrp.Position
            local distance = vectorToTrail.Magnitude

            if distance <= ABSettings.MaxDistance and distance > ABSettings.MinDistance then
                local lookVector = hrp.CFrame.LookVector
                local directionToTrail = vectorToTrail.Unit
                
                if lookVector:Dot(directionToTrail) >= ABSettings.AheadThreshold then
                    triggerBlock()
                    break 
                end
            end
        end
    end
end

task.spawn(function()
    while not EffectsFolder do task.wait(0.5) end
    for _, child in ipairs(EffectsFolder:GetChildren()) do checkPart(child) end
    table.insert(_G.AutoBlockState.Connections, EffectsFolder.ChildAdded:Connect(checkPart))
end)
table.insert(_G.AutoBlockState.Connections, RunService.Heartbeat:Connect(checkActiveTrails))

