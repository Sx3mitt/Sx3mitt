local function easeOutCubic(t)
    local inv = 1 - t
    return 1 - (inv * inv * inv)
end

local function isBehindTarget(targetHRP, myHRP)
    local targetForward = targetHRP.CFrame.LookVector
    local toPlayer = (myHRP.Position - targetHRP.Position).Unit
    return targetForward:Dot(toPlayer) < -0.3
end

local function getBehindPos(tHRP, currentY, customRadius)
    local r = customRadius or BFSettings.Radius
    local lookFlat = Vector3.new(tHRP.CFrame.LookVector.X, 0, tHRP.CFrame.LookVector.Z).Unit
    return Vector3.new(tHRP.Position.X, currentY, tHRP.Position.Z) - lookFlat * r
end

local function startBlackFlashDash(skipInitialFire)
    if not _G.BlackFlashState.Enabled then return end

    local target = getNearestTarget()
    local myChar = LocalPlayer.Character
    local myHRP  = getHRP(myChar)
    local hum    = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not target or not myHRP or not hum then return end
    
    local tHRP = getHRP(target)
    if not tHRP then return end

    local alreadyBehind   = isBehindTarget(tHRP, myHRP)
    local BlackFlashReach = BFSettings.Radius + 2.5
    local distToEnemy     = (myHRP.Position - tHRP.Position).Magnitude

    if _G.BlackFlashState.DashConn then
        _G.BlackFlashState.DashConn:Disconnect()
        _G.BlackFlashState.DashConn = nil
    end

    if alreadyBehind and distToEnemy <= BlackFlashReach then
        if not skipInitialFire then fireRemote() end
        return
    end

    if not skipInitialFire then fireRemote() end
    task.wait(0.05)

    local startTime = os.clock()
    local duration = BFSettings.Duration
    
    -- Grab the full 3D positions instead of flattening the Y axis
    local startPos = myHRP.Position
    local smoothedTargetPos = tHRP.Position
    local endY = tHRP.Position.Y -- Target's current height

    local fixedEndPos = getBehindPos(tHRP, endY)

    local function getSideControlPoint(targetPos)
        -- Determine which side to curve on using flat 2D math so it doesn't break
        local rightVec = Vector3.new(tHRP.CFrame.RightVector.X, 0, tHRP.CFrame.RightVector.Z).Unit
        local toPlayer = Vector3.new(startPos.X, 0, startPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)
        local sideSign = toPlayer:Dot(rightVec) >= 0 and 1 or -1
        
        -- Place the curve's vertical height exactly in the middle of your height and the enemy's height
        local midY = (startPos.Y + endY) / 2
        return Vector3.new(targetPos.X, midY, targetPos.Z) + rightVec * (BFSettings.CurveStrength * sideSign)
    end

    local controlPt = getSideControlPoint(tHRP.Position)
    hum.AutoRotate  = false

    -- Separate X, Y, and Z for full 3D Bezier curve math
    local sx, sy, sz = startPos.X, startPos.Y, startPos.Z
    local cx, cy, cz = controlPt.X, controlPt.Y, controlPt.Z
    local ex, ey, ez = fixedEndPos.X, fixedEndPos.Y, fixedEndPos.Z

    if alreadyBehind then
        _G.BlackFlashState.DashConn = RunService.Heartbeat:Connect(function()
            -- Nullify game physics dragging the dash
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
            
            local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
            if alpha >= 1 or not tHRP.Parent then
                _G.BlackFlashState.DashConn:Disconnect()
                _G.BlackFlashState.DashConn = nil
                hum.AutoRotate = true
                return
            end
            
            local eased = easeOutCubic(alpha)
            local moveX = sx + (ex - sx) * eased
            local moveY = sy + (ey - sy) * eased -- Smoothly shift height
            local moveZ = sz + (ez - sz) * eased
            
            -- Look at target's grounded position
            myHRP.CFrame = CFrame.new(Vector3.new(moveX, moveY, moveZ), Vector3.new(tHRP.Position.X, ey, tHRP.Position.Z))
        end)
    else
        _G.BlackFlashState.DashConn = RunService.Heartbeat:Connect(function()
            -- Nullify game physics dragging the dash
            myHRP.AssemblyLinearVelocity = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
            
            local linearAlpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
            smoothedTargetPos = smoothedTargetPos:Lerp(tHRP.Position, 0.2)
            
            if linearAlpha >= 1 or not tHRP.Parent then
                _G.BlackFlashState.DashConn:Disconnect()
                _G.BlackFlashState.DashConn = nil
                hum.AutoRotate = true
                -- Final snap to destination
                myHRP.CFrame = CFrame.new(Vector3.new(ex, ey, ez), Vector3.new(smoothedTargetPos.X, smoothedTargetPos.Y, smoothedTargetPos.Z))
                return
            end
            
            local easedAlpha = easeOutCubic(linearAlpha)
            local t  = 1 - (1 - easedAlpha) * (1 - easedAlpha)
            local t1 = 1 - t
            
            local bx = cx * (1 - easedAlpha) + ex * easedAlpha
            local by = cy * (1 - easedAlpha) + ey * easedAlpha
            local bz = cz * (1 - easedAlpha) + ez * easedAlpha
            
            local t1Sq = t1 * t1
            local tSq = t * t
            local twoT1T = 2 * t1 * t

            -- Full 3D Quadratic Bezier Curve
            local moveX = t1Sq * sx + twoT1T * bx + tSq * ex
            local moveY = t1Sq * sy + twoT1T * by + tSq * ey 
            local moveZ = t1Sq * sz + twoT1T * bz + tSq * ez

            -- Look at target's actual 3D position while swooping
            myHRP.CFrame = CFrame.new(Vector3.new(moveX, moveY, moveZ), Vector3.new(smoothedTargetPos.X, smoothedTargetPos.Y, smoothedTargetPos.Z))
        end)
    end
end

